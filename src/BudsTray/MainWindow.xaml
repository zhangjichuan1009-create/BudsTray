<Window x:Class="RedmiBudsTray.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="蓝牙耳机" Width="420" Height="360"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False"
        Background="{DynamicResource PanelBackground}" Deactivated="Window_Deactivated"
        Opacity="1" UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Window.Resources>
        <CubicEase x:Key="EaseOut" EasingMode="EaseOut"/>
        <SolidColorBrush x:Key="PanelBackground" Color="#F7F8FA"/>
        <SolidColorBrush x:Key="BackdropTint" Color="#F7F8FA"/>
        <SolidColorBrush x:Key="CardBackground" Color="#FFFFFFFF"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#191919"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#5D5D5D"/>
        <SolidColorBrush x:Key="Accent" Color="#086CC9"/>
        <SolidColorBrush x:Key="AccentSoft" Color="#EAF3FC"/>
        <SolidColorBrush x:Key="SubtleBorder" Color="#16000000"/>
        <SolidColorBrush x:Key="HoverBackground" Color="#0D000000"/>
        <SolidColorBrush x:Key="ChargingForeground" Color="#168248"/>
        <SolidColorBrush x:Key="ToggleTrack" Color="#D0D0D0"/>

        <Style TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI Variable Text, Microsoft YaHei UI, Segoe UI"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
        </Style>
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBackground}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SubtleBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
        </Style>
        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="Width" Value="34"/><Setter Property="Height" Value="34"/>
            <Setter Property="FontFamily" Value="Segoe Fluent Icons"/><Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/><Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/><Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Border x:Name="Root" Background="{TemplateBinding Background}" CornerRadius="8"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Root" Property="Background" Value="{DynamicResource HoverBackground}"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="Root" Property="Opacity" Value="0.65"/></Trigger></ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="ConnectButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="White"/><Setter Property="Background" Value="{DynamicResource Accent}"/>
            <Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="14,7"/><Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontFamily" Value="Segoe UI Variable Text, Microsoft YaHei UI"/><Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Border x:Name="Root" Background="{TemplateBinding Background}" CornerRadius="8"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Root" Property="Opacity" Value="0.9"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="Root" Property="Opacity" Value="0.72"/></Trigger></ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="ModeButton" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/><Setter Property="Padding" Value="10,10"/>
            <Setter Property="FontFamily" Value="Segoe UI Variable Text, Microsoft YaHei UI"/><Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton">
                <Border Background="Transparent" CornerRadius="9"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsChecked" Value="True"><Setter Property="Foreground" Value="White"/></Trigger>
                    <Trigger Property="IsMouseOver" Value="True"><Setter Property="Opacity" Value="0.82"/></Trigger>
                    <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.38"/><Setter Property="Cursor" Value="Arrow"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="ToggleStyle" TargetType="CheckBox">
            <Setter Property="Width" Value="40"/><Setter Property="Height" Value="22"/><Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox">
                <Grid>
                    <Border x:Name="Track" Background="{DynamicResource ToggleTrack}" CornerRadius="11"/>
                    <Ellipse x:Name="Thumb" Width="16" Height="16" Fill="White" HorizontalAlignment="Left" Margin="3,0"/>
                </Grid>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsChecked" Value="True"><Setter TargetName="Track" Property="Background" Value="{DynamicResource Accent}"/><Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/></Trigger>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Track" Property="Opacity" Value="0.88"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="DeviceButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="BorderThickness" Value="0"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}"><ContentPresenter VerticalAlignment="Center"/></Border>
                <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="{DynamicResource HoverBackground}"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="Background" Value="{DynamicResource HoverBackground}"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.55"/></Trigger></ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="VolumeSliderStyle" TargetType="Slider">
            <Setter Property="Height" Value="32"/><Setter Property="IsMoveToPointEnabled" Value="True"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Slider">
                <Grid x:Name="Surface">
                    <Track x:Name="PART_Track" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" Value="{TemplateBinding Value}">
                        <Track.DecreaseRepeatButton><RepeatButton Command="Slider.DecreaseLarge"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Height="4" CornerRadius="2" Background="{DynamicResource Accent}"/></ControlTemplate></RepeatButton.Template></RepeatButton></Track.DecreaseRepeatButton>
                        <Track.IncreaseRepeatButton><RepeatButton Command="Slider.IncreaseLarge"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Height="4" CornerRadius="2" Background="{DynamicResource ToggleTrack}"/></ControlTemplate></RepeatButton.Template></RepeatButton></Track.IncreaseRepeatButton>
                        <Track.Thumb><Thumb Width="16" Height="16"><Thumb.Template><ControlTemplate TargetType="Thumb"><Ellipse Fill="White" Stroke="{DynamicResource Accent}" StrokeThickness="4"/></ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
                    </Track>
                </Grid>
                <ControlTemplate.Triggers><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.4"/></Trigger></ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
    </Window.Resources>

    <Viewbox Stretch="Uniform" StretchDirection="DownOnly">
    <Border x:Name="PanelSurface" Width="420" Height="360" Background="{DynamicResource BackdropTint}" BorderBrush="{DynamicResource SubtleBorder}" BorderThickness="1" CornerRadius="14" Padding="24">
        <Grid>
            <Grid x:Name="HomePage">
                <Grid.Style><Style TargetType="Grid"><Style.Triggers>
                    <DataTrigger Binding="{Binding Visibility, ElementName=SettingsPage}" Value="Visible"><Setter Property="Visibility" Value="Hidden"/></DataTrigger>
                </Style.Triggers></Style></Grid.Style>
            
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/><RowDefinition x:Name="HeaderGapRow" Height="14"/><RowDefinition x:Name="BatteryRow" Height="100"/>
                <RowDefinition x:Name="ModeGapRow" Height="14"/><RowDefinition Height="Auto"/><RowDefinition x:Name="VolumeGapRow" Height="14"/>
                <RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid x:Name="DeviceHeader" Grid.Row="0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="52"/><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Border Width="44" Height="44" CornerRadius="12" Background="{DynamicResource AccentSoft}" HorizontalAlignment="Left">
                    <Viewbox x:Name="HeadphoneIcon" Width="24" Height="24" HorizontalAlignment="Center" VerticalAlignment="Center" SnapsToDevicePixels="False" UseLayoutRounding="False">
                        <Canvas Width="24" Height="24">
                            <Path Data="M 4,14 L 4,11 A 8,8 0 0 1 20,11 L 20,14 M 4,13 L 7,13 L 7,21 L 4,21 Q 2.5,21 2.5,19.5 L 2.5,14.5 Q 2.5,13 4,13 M 20,13 L 17,13 L 17,21 L 20,21 Q 21.5,21 21.5,19.5 L 21.5,14.5 Q 21.5,13 20,13" Stroke="{DynamicResource Accent}" StrokeThickness="1.65" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                        </Canvas>
                    </Viewbox>
                </Border>
                <StackPanel x:Name="DeviceTitleArea" Grid.Column="1" VerticalAlignment="Center">
                    <Button x:Name="DevicePickerButton" HorizontalAlignment="Left" MaxWidth="{Binding ActualWidth, ElementName=DeviceTitleArea}" Margin="-4,-2,8,0" Padding="4,2" Style="{StaticResource DeviceButton}" Click="DevicePicker_Click" ToolTip="切换耳机与声音输出" AutomationProperties.Name="切换耳机">
                        <DockPanel>
                            <TextBlock x:Name="DevicePickerChevron" DockPanel.Dock="Right" Text="&#xE70D;" FontFamily="Segoe Fluent Icons" FontSize="10" Margin="6,0,0,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="DeviceNameText" Text="蓝牙耳机" FontFamily="Segoe UI Variable Display, Microsoft YaHei UI" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                        </DockPanel>
                    </Button>
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <Ellipse x:Name="StatusDot" Width="7" Height="7" Fill="#8A8886" Margin="0,0,7,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="StatusText" Text="未连接" FontSize="12.5" Foreground="{DynamicResource TextSecondary}"/>
                    </StackPanel>
                </StackPanel>
                <Button x:Name="DisconnectButton" Grid.Column="2" Style="{StaticResource IconButton}" Content="&#xE8D8;" ToolTip="断开耳机连接" Click="Disconnect_Click" Visibility="Collapsed"/>
                <Button Grid.Column="3" Style="{StaticResource IconButton}" Content="&#xE713;" ToolTip="设置" Click="Settings_Click"/>
            </Grid>

            <Grid x:Name="BatteryPanel" Grid.Row="2" Visibility="Collapsed">
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="10"/><ColumnDefinition/><ColumnDefinition Width="10"/><ColumnDefinition/></Grid.ColumnDefinitions>
                <Border Grid.Column="0" Style="{StaticResource CardStyle}"><StackPanel VerticalAlignment="Center"><StackPanel.Resources><Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}"><Setter Property="HorizontalAlignment" Value="Center"/><Setter Property="TextAlignment" Value="Center"/></Style></StackPanel.Resources><Border Width="25" Height="25" CornerRadius="13" Background="{DynamicResource AccentSoft}"><TextBlock Text="L" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource Accent}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="左耳" FontSize="13" FontWeight="Medium" Foreground="{DynamicResource TextSecondary}" Margin="0,7,0,0"/><TextBlock x:Name="LeftBatteryText" Text="—" FontFamily="Segoe UI Variable Display, Segoe UI" FontSize="23" FontWeight="SemiBold" Margin="0,1,0,0"/><TextBlock x:Name="LeftChargingText" Text="充电中" FontSize="10" Foreground="{DynamicResource ChargingForeground}" Height="15" Visibility="Hidden"/></StackPanel></Border>
                <Border Grid.Column="2" Style="{StaticResource CardStyle}"><StackPanel VerticalAlignment="Center"><StackPanel.Resources><Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}"><Setter Property="HorizontalAlignment" Value="Center"/><Setter Property="TextAlignment" Value="Center"/></Style></StackPanel.Resources><Border Width="25" Height="25" CornerRadius="13" Background="{DynamicResource AccentSoft}"><TextBlock Text="R" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource Accent}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="右耳" FontSize="13" FontWeight="Medium" Foreground="{DynamicResource TextSecondary}" Margin="0,7,0,0"/><TextBlock x:Name="RightBatteryText" Text="—" FontFamily="Segoe UI Variable Display, Segoe UI" FontSize="23" FontWeight="SemiBold" Margin="0,1,0,0"/><TextBlock x:Name="RightChargingText" Text="充电中" FontSize="10" Foreground="{DynamicResource ChargingForeground}" Height="15" Visibility="Hidden"/></StackPanel></Border>
                <Border Grid.Column="4" Style="{StaticResource CardStyle}"><StackPanel VerticalAlignment="Center"><StackPanel.Resources><Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}"><Setter Property="HorizontalAlignment" Value="Center"/><Setter Property="TextAlignment" Value="Center"/></Style></StackPanel.Resources><TextBlock Text="&#xE83F;" FontFamily="Segoe Fluent Icons" FontSize="19" Foreground="{DynamicResource Accent}" Height="25"/><TextBlock Text="充电盒" FontSize="13" FontWeight="Medium" Foreground="{DynamicResource TextSecondary}" Margin="0,7,0,0"/><TextBlock x:Name="CaseBatteryText" Text="—" FontFamily="Segoe UI Variable Display, Segoe UI" FontSize="23" FontWeight="SemiBold" Margin="0,1,0,0"/><TextBlock x:Name="CaseChargingText" Text="充电中" FontSize="10" Foreground="{DynamicResource ChargingForeground}" Height="15" Visibility="Hidden"/></StackPanel></Border>
            </Grid>

            <Border x:Name="HeadphonePanel" Grid.Row="2" Visibility="Collapsed">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <Grid Width="70" Height="70">
                        <Ellipse Margin="3" Fill="{DynamicResource CardBackground}" Stroke="{DynamicResource SubtleBorder}" StrokeThickness="4"/>
                        <Path x:Name="HeadphoneChargeArc" Stroke="{DynamicResource Accent}" StrokeThickness="4" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                        <TextBlock x:Name="HeadphoneBatteryText" Text="—" FontFamily="Segoe UI Variable Display, Segoe UI" FontSize="21" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                    <TextBlock Text="耳机电量" FontSize="12.5" Foreground="{DynamicResource TextSecondary}" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                </StackPanel>
            </Border>

            <StackPanel x:Name="SoundPanel" Grid.Row="4" Visibility="Collapsed">
                <TextBlock Text="声音模式" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,0,9"/>
                <Border Style="{StaticResource CardStyle}" Padding="4">
                    <Grid x:Name="ModeSelectorGrid" Height="40" ClipToBounds="True">
                        <Border x:Name="ModeIndicator" Width="118" Height="40" Opacity="0" HorizontalAlignment="Left" CornerRadius="9" Background="{DynamicResource Accent}">
                            <Border.RenderTransform><TranslateTransform x:Name="ModeIndicatorTransform"/></Border.RenderTransform>
                        </Border>
                        <UniformGrid Rows="1">
                            <RadioButton x:Name="AncButton" GroupName="Noise" Content="降噪" Style="{StaticResource ModeButton}" Tag="1" Click="Mode_Click"/>
                            <RadioButton x:Name="TransparencyButton" GroupName="Noise" Content="通透" Style="{StaticResource ModeButton}" Tag="2" Click="Mode_Click"/>
                            <RadioButton x:Name="OffButton" GroupName="Noise" Content="关闭" Style="{StaticResource ModeButton}" Tag="0" Click="Mode_Click"/>
                        </UniformGrid>
                    </Grid>
                </Border>
            </StackPanel>

            <Border x:Name="VolumePanel" Grid.Row="6" Style="{StaticResource CardStyle}" Padding="10,5" Visibility="Collapsed"
                    PreviewMouseLeftButtonDown="Volume_SurfaceDown" PreviewMouseMove="Volume_SurfaceMove" PreviewMouseLeftButtonUp="Volume_SurfaceUp">
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="34"/><ColumnDefinition/><ColumnDefinition Width="38"/></Grid.ColumnDefinitions>
                    <Button x:Name="VolumeMuteButton" Style="{StaticResource IconButton}" Width="28" Height="28" FontSize="17" Content="&#xE767;" Click="VolumeMute_Click" ToolTip="静音" AutomationProperties.Name="静音"/>
                    <Slider x:Name="VolumeSlider" Grid.Column="1" Style="{StaticResource VolumeSliderStyle}" Minimum="0" Maximum="100" SmallChange="1" LargeChange="5" Margin="8,0" ValueChanged="Volume_ValueChanged" LostMouseCapture="Volume_SurfaceLostCapture" AutomationProperties.Name="所选耳机音量"/>
                    <TextBlock x:Name="VolumeValueText" Grid.Column="2" Text="—" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <Grid Grid.Row="8">
                
            </Grid>

            <Border x:Name="DisconnectedPanel" Grid.Row="2" Grid.RowSpan="7" Background="{DynamicResource PanelBackground}" Visibility="Collapsed">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <Button x:Name="ConnectButton" Width="120" Height="42" HorizontalAlignment="Center" Style="{StaticResource ConnectButtonStyle}" Click="Connect_Click" AutomationProperties.Name="连接耳机">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Grid x:Name="ConnectSpinner" Width="14" Height="14" Margin="0,0,8,0" Visibility="Collapsed" RenderTransformOrigin="0.5,0.5">
                                <Grid.RenderTransform><RotateTransform x:Name="SpinnerRotation"/></Grid.RenderTransform>
                                <Ellipse Stroke="#55FFFFFF" StrokeThickness="2"/>
                                <Path Data="M 7,1 A 6,6 0 0 1 13,7" Stroke="White" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                            </Grid>
                            <TextBlock x:Name="ConnectLabel" Text="连接" Foreground="White" VerticalAlignment="Center" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>
            <Border x:Name="EmptyDevicesPanel" Grid.Row="0" Grid.RowSpan="9" Background="{DynamicResource PanelBackground}" Visibility="Collapsed">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <Border Width="52" Height="52" CornerRadius="16" Background="{DynamicResource AccentSoft}" HorizontalAlignment="Center"><TextBlock Text="&#xE710;" FontFamily="Segoe Fluent Icons" FontSize="25" Foreground="{DynamicResource Accent}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                    <TextBlock Text="添加你的耳机" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,18,0,0"/>
                    <TextBlock Text="从 Windows 已配对设备中选择" FontSize="13" Foreground="{DynamicResource TextSecondary}" HorizontalAlignment="Center" Margin="0,8,0,22"/>
                    <Button Width="136" Height="38" Content="添加设备" Style="{StaticResource ConnectButtonStyle}" Click="AddDeviceGuide_Click"/>
                </StackPanel>
            </Border>
            </Grid>
            <Border x:Name="SettingsPage" Background="{DynamicResource PanelBackground}" Visibility="Collapsed">
                <Viewbox x:Name="SettingsContent" Stretch="Uniform" StretchDirection="DownOnly" VerticalAlignment="Top">
                <Grid Width="370">
                <StackPanel x:Name="GeneralSettingsStack">
                    <StackPanel.Style><Style TargetType="StackPanel"><Style.Triggers>
                        <DataTrigger Binding="{Binding Visibility, ElementName=RedmiDevicePage}" Value="Visible"><Setter Property="Visibility" Value="Hidden"/></DataTrigger>
                    </Style.Triggers></Style></StackPanel.Style>
                    <DockPanel Margin="0,0,0,16">
                        <Button Style="{StaticResource IconButton}" Content="&#xE72B;" ToolTip="返回耳机" Click="Back_Click"/>
                        <TextBlock Text="设置" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" Margin="10,0,0,0"/>
                    </DockPanel>
                    <Border Style="{StaticResource CardStyle}" Padding="14">
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Text="随 Windows 启动" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" ToolTip="登录后在托盘运行"/>
                            <CheckBox x:Name="AutoStartToggle" Grid.Column="1" Style="{StaticResource ToggleStyle}" VerticalAlignment="Center" Click="AutoStart_Click"/>
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource CardStyle}" Padding="14" Margin="0,10,0,0">
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Text="低电量提醒" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" ToolTip="电量降至 20% 时提醒一次"/>
                            <CheckBox x:Name="LowBatteryToggle" Grid.Column="1" Style="{StaticResource ToggleStyle}" VerticalAlignment="Center" Click="LowBattery_Click" AutomationProperties.Name="低电量提醒"/>
                        </Grid>
                    </Border>
                    <TextBlock x:Name="SettingsHint" TextAlignment="Center" Text="" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondary}" FontSize="12" Margin="4,8,4,0">
                        <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}"><Style.Triggers><Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed"/></Trigger></Style.Triggers></Style></TextBlock.Style>
                    </TextBlock>
                    <Border x:Name="ProtocolInfoCard" Style="{StaticResource CardStyle}" Padding="10,8" Margin="0,10,0,0">
                        <Button Style="{StaticResource DeviceButton}" Padding="4,4" Click="ManageDevices_Click"><DockPanel><TextBlock DockPanel.Dock="Right" Text="&#xE76C;" FontFamily="Segoe Fluent Icons" FontSize="12" VerticalAlignment="Center"/><TextBlock Text="管理设备" FontSize="13" FontWeight="SemiBold"/></DockPanel></Button>
                    </Border>
                    <Border x:Name="RedmiSettingsEntry" Style="{StaticResource CardStyle}" Padding="10,8" Margin="0,10,0,0" Visibility="Collapsed">
                        <Button Style="{StaticResource DeviceButton}" Click="RedmiSettings_Click" Padding="4,6" ToolTip="查看耳机信息和设置">
                            <DockPanel><TextBlock DockPanel.Dock="Right" Text="&#xE76C;" FontFamily="Segoe Fluent Icons" FontSize="12" VerticalAlignment="Center"/><TextBlock Text="耳机设置" FontSize="13" FontWeight="SemiBold"/></DockPanel>
                        </Button>
                    </Border>
                    <Border x:Name="OneMoreSettings" Style="{StaticResource CardStyle}" Padding="14" Margin="0,10,0,0" Visibility="Collapsed">
                        <StackPanel>
                            <Grid x:Name="OneMoreDualRow"><TextBlock Text="双设备连接" FontSize="13" FontWeight="SemiBold"/><TextBlock x:Name="DualDeviceStatus" FontSize="13" Foreground="{DynamicResource TextSecondary}" HorizontalAlignment="Right"/></Grid>
                            <Grid x:Name="OneMoreLdacRow" Margin="0,16,0,0" ToolTip="耳机的 LDAC 开关，不代表 Windows 当前正在使用 LDAC"><TextBlock Text="LDAC" FontSize="13" FontWeight="SemiBold"/><TextBlock x:Name="LdacStatus" FontSize="13" Foreground="{DynamicResource TextSecondary}" HorizontalAlignment="Right"/></Grid>
                            <Grid x:Name="OneMoreFirmwareRow" Margin="0,16,0,0"><TextBlock Text="固件版本" FontSize="13" FontWeight="SemiBold"/><TextBlock x:Name="FirmwareText" FontSize="13" Foreground="{DynamicResource TextSecondary}" HorizontalAlignment="Right"/></Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
                <Border x:Name="RedmiDevicePage" Background="{DynamicResource PanelBackground}" Visibility="Collapsed">
                    <StackPanel x:Name="RedmiDeviceContent">
                        <DockPanel Margin="0,0,0,16">
                            <Button Style="{StaticResource IconButton}" Content="&#xE72B;" ToolTip="返回设置" Click="RedmiSettingsBack_Click"/>
                            <TextBlock Text="耳机设置" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" Margin="10,0,0,0"/>
                        </DockPanel>
                        <Border Style="{StaticResource CardStyle}" Padding="14">
                            <StackPanel>
                                <Grid x:Name="RedmiFirmwareRow"><TextBlock Text="固件版本" FontSize="13" FontWeight="SemiBold"/><TextBlock x:Name="RedmiFirmwareText" FontSize="13" Foreground="{DynamicResource TextSecondary}" HorizontalAlignment="Right"/></Grid>
                                <Grid x:Name="RedmiDualRow" Margin="0,12,0,0"><TextBlock Text="双设备连接" FontSize="13" FontWeight="SemiBold"/><TextBlock x:Name="RedmiDualText" FontSize="13" Foreground="{DynamicResource TextSecondary}" HorizontalAlignment="Right"/></Grid>
                                <Grid x:Name="RedmiEqRow" Margin="0,12,0,0"><TextBlock Text="EQ 预设" FontSize="13" FontWeight="SemiBold"/><TextBlock x:Name="RedmiEqText" FontSize="13" Foreground="{DynamicResource TextSecondary}" HorizontalAlignment="Right"/></Grid>
                                <Grid x:Name="RedmiAdaptiveAncRow" Margin="0,12,0,0"><TextBlock Text="自适应降噪" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/><CheckBox x:Name="RedmiAdaptiveAncToggle" Tag="AdaptiveAnc" Style="{StaticResource ToggleStyle}" HorizontalAlignment="Right" Click="RedmiSetting_Click"/></Grid>
                                <Grid x:Name="RedmiAdaptiveSoundRow" Margin="0,12,0,0"><TextBlock Text="自适应音效" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/><CheckBox x:Name="RedmiAdaptiveSoundToggle" Tag="AdaptiveSound" Style="{StaticResource ToggleStyle}" HorizontalAlignment="Right" Click="RedmiSetting_Click"/></Grid>
                                <Grid x:Name="RedmiAutoAnswerRow" Margin="0,12,0,0"><TextBlock Text="自动接听" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/><CheckBox x:Name="RedmiAutoAnswerToggle" Tag="AutoAnswer" Style="{StaticResource ToggleStyle}" HorizontalAlignment="Right" Click="RedmiSetting_Click"/></Grid>
                                <Grid x:Name="RedmiStrengthRow" Margin="0,12,0,0"><TextBlock Text="降噪强度" FontSize="13" FontWeight="SemiBold"/><TextBlock x:Name="RedmiStrengthText" FontSize="13" Foreground="{DynamicResource TextSecondary}" HorizontalAlignment="Right"/></Grid>
                            </StackPanel>
                        </Border>
                        <TextBlock x:Name="RedmiSettingsHint" Text="" FontSize="12" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" TextAlignment="Center" Margin="4,10,4,0">
                            <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}"><Style.Triggers><Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed"/></Trigger></Style.Triggers></Style></TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Border>
                </Grid>
                </Viewbox>
            </Border>
            <Border x:Name="DevicePicker" Grid.Row="0" Grid.RowSpan="9" Margin="0,58,0,0" VerticalAlignment="Top" Style="{StaticResource CardStyle}" Background="{DynamicResource PanelBackground}" Padding="6" Visibility="Collapsed">
                <StackPanel><ScrollViewer MaxHeight="192" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled"><StackPanel x:Name="DevicePickerItems"/></ScrollViewer><Button Content="管理设备" Height="38" Padding="12,0,12,0" Style="{StaticResource DeviceButton}" Click="ManageDevices_Click"/></StackPanel>
            </Border>
            <Border x:Name="DevicesPage" Background="{DynamicResource PanelBackground}" Visibility="Collapsed">
                <Grid x:Name="DevicesContent">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <DockPanel Margin="0,0,0,16"><Button Style="{StaticResource IconButton}" Content="&#xE72B;" ToolTip="返回" Click="DevicesBack_Click"/><TextBlock x:Name="DevicesPageTitle" Text="管理设备" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" Margin="10,0,0,0"/></DockPanel>
                    <Grid Grid.Row="1"><ScrollViewer VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly"><StackPanel x:Name="ManagedDeviceItems"/></ScrollViewer><TextBlock x:Name="DevicesEmptyText" Text="还没有添加设备" FontSize="14" Foreground="{DynamicResource TextSecondary}" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Margin="8" Visibility="Collapsed"/></Grid>
                    <StackPanel Grid.Row="2" Margin="0,12,0,0"><TextBlock x:Name="DevicesError" FontSize="13" Foreground="{DynamicResource TextSecondary}" TextAlignment="Center" TextWrapping="Wrap" Margin="0,0,0,8" Visibility="Collapsed"/><Button x:Name="DevicesActionButton" Height="38" Content="添加设备" Style="{StaticResource ConnectButtonStyle}" Click="DevicesAction_Click"/></StackPanel>
                </Grid>
            </Border>
            <Border x:Name="DeviceConfigPage" Background="{DynamicResource PanelBackground}" Visibility="Collapsed">
                <StackPanel x:Name="DeviceConfigContent">
                    <DockPanel Margin="0,0,0,12"><Button Style="{StaticResource IconButton}" Content="&#xE72B;" Click="DeviceConfigBack_Click"/><TextBlock Text="协议与功能" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" Margin="10,0,0,0"/></DockPanel>
                    <TextBlock x:Name="ConfigDeviceName" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,0,0,8"/>
                    <Border Style="{StaticResource CardStyle}" Padding="10"><StackPanel><TextBlock Text="控制协议" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,7"/><UniformGrid Rows="1" Columns="3"><Button x:Name="ConfigAutoProtocol" Style="{StaticResource DeviceButton}" Height="32" Tag="Auto" Click="ConfigProtocol_Click"><TextBlock Text="自动" TextAlignment="Center"/></Button><Button x:Name="ConfigXiaomiProtocol" Style="{StaticResource DeviceButton}" Height="32" Tag="Xiaomi" Click="ConfigProtocol_Click"><TextBlock Text="小米" TextAlignment="Center"/></Button><Button x:Name="ConfigOneMoreProtocol" Style="{StaticResource DeviceButton}" Height="32" Tag="OneMore" Click="ConfigProtocol_Click"><TextBlock Text="万魔" TextAlignment="Center"/></Button></UniformGrid></StackPanel></Border>
                    <Border Style="{StaticResource CardStyle}" Padding="12" Margin="0,8,0,0"><StackPanel><Grid><TextBlock Text="显示降噪按钮" FontSize="13" VerticalAlignment="Center"/><CheckBox x:Name="ConfigAncToggle" HorizontalAlignment="Right" Style="{StaticResource ToggleStyle}"/></Grid><Grid Margin="0,12,0,0"><TextBlock Text="显示通透按钮" FontSize="13" VerticalAlignment="Center"/><CheckBox x:Name="ConfigTransparencyToggle" HorizontalAlignment="Right" Style="{StaticResource ToggleStyle}"/></Grid></StackPanel></Border>
                    <TextBlock Text="保存不切换声音模式，返回面板后可自行试用。" FontSize="12" Foreground="{DynamicResource TextSecondary}" TextAlignment="Center" Margin="0,10,0,10"/>
                    <UniformGrid Rows="1" Columns="2"><Button Style="{StaticResource DeviceButton}" Height="36" Click="ConfigReset_Click"><TextBlock Text="恢复自动" TextAlignment="Center"/></Button><Button x:Name="ConfigSaveButton" Content="保存" Style="{StaticResource ConnectButtonStyle}" Height="36" Margin="8,0,0,0" Click="ConfigSave_Click"/></UniformGrid>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
    </Viewbox>
</Window>
