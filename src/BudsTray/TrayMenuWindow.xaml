<Window x:Class="RedmiBudsTray.TrayMenuWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Width="208" Height="140" WindowStyle="None" ResizeMode="NoResize"
 ShowInTaskbar="False" Topmost="True" Background="{DynamicResource PanelBackground}"
 UseLayoutRounding="True" SnapsToDevicePixels="True" Title="耳机菜单">
 <Window.Resources>
  <Style TargetType="Button">
   <Setter Property="Height" Value="38"/>
   <Setter Property="Margin" Value="0,1"/>
   <Setter Property="Background" Value="Transparent"/>
   <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
   <Setter Property="FontFamily" Value="Segoe UI Variable Text, Microsoft YaHei UI"/>
   <Setter Property="FontSize" Value="13"/>
   <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
   <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
    <Border x:Name="Surface" CornerRadius="5" Background="{TemplateBinding Background}" Padding="12,0" BorderThickness="1" BorderBrush="Transparent">
     <ContentPresenter VerticalAlignment="Center"/>
    </Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="{DynamicResource HoverBackground}"/></Trigger>
     <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="Background" Value="{DynamicResource HoverBackground}"/><Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource TextSecondary}"/></Trigger>
     <Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.65"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
 </Window.Resources>
 <Border BorderBrush="{DynamicResource SubtleBorder}" BorderThickness="1" CornerRadius="8" Padding="5">
  <StackPanel KeyboardNavigation.TabNavigation="Cycle">
   <Button x:Name="OpenItem" Click="Open_Click" AutomationProperties.Name="打开面板"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition/></Grid.ColumnDefinitions><TextBlock Text="&#xE7F6;" FontFamily="Segoe Fluent Icons" FontSize="16" VerticalAlignment="Center"/><TextBlock Grid.Column="1" Text="打开面板"/></Grid></Button>
   <Button x:Name="SettingsItem" Click="Settings_Click" AutomationProperties.Name="设置"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition/></Grid.ColumnDefinitions><TextBlock Text="&#xE713;" FontFamily="Segoe Fluent Icons" FontSize="16" VerticalAlignment="Center"/><TextBlock Grid.Column="1" Text="设置"/></Grid></Button>
   <Border Height="1" Background="{DynamicResource SubtleBorder}" Margin="8,3"/>
   <Button x:Name="ExitItem" Click="Exit_Click" AutomationProperties.Name="退出应用"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition/></Grid.ColumnDefinitions><TextBlock Text="&#xE7E8;" FontFamily="Segoe Fluent Icons" FontSize="16" VerticalAlignment="Center"/><TextBlock Grid.Column="1" Text="退出应用"/></Grid></Button>
  </StackPanel>
 </Border>
</Window>
